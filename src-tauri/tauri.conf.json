{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ringlight",
  "version": "0.3.1",
  "identifier": "com.alexandre.ringlight",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "settings",
        "title": "Ringlight",
        "url": "index.html",
        "width": 460,
        "height": 900,
        "minWidth": 400,
        "minHeight": 520,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["English", "PortugueseBR"],
        "displayLanguageSelector": false
      }
    }
  }
}
